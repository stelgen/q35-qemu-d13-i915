+static void bochs_reblit_work(struct work_struct *work)
+{
+	struct bochs_device *bochs = container_of(work, struct bochs_device,
+						  reblit_work.work);
+	struct drm_plane *plane = &bochs->primary_plane;
+	struct drm_framebuffer *fb = plane->state->fb;
+
+	/*
+	 * Experiment: re-copy the current plane fb into VRAM without any
+	 * userspace atomic commit (best-effort, no locking, debug only).
+	 * If the picture comes alive while userspace is idle, the compositor
+	 * stopped committing; the kernel copy path itself works.
+	 */
+	if (fb && bochs->stride) {
+		struct iosys_map map[DRM_FORMAT_MAX_PLANES] = { };
+		struct iosys_map data[DRM_FORMAT_MAX_PLANES] = { };
+		struct drm_rect full = DRM_RECT_INIT(0, 0, fb->width, fb->height);
+		struct iosys_map dst = IOSYS_MAP_INIT_VADDR_IOMEM(bochs->fb_map);
+
+		if (!drm_gem_fb_vmap(fb, map, data)) {
+			iosys_map_incr(&dst, drm_fb_clip_offset(fb->pitches[0],
+							       fb->format, &full));
+			drm_fb_memcpy(&dst, fb->pitches, data, fb, &full);
+			drm_gem_fb_vunmap(fb, map);
+		}
+	}
+
+	schedule_delayed_work(&bochs->reblit_work,
+			      msecs_to_jiffies(bochs_reblit_ms));
+}
